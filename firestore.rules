rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isMasterDeveloper() {
      return isSignedIn() && request.auth.token.email != null &&
        request.auth.token.email.lower() == 'mikmellorg@gmail.com';
    }

    function isMasterAdmin() {
      return isMasterDeveloper();
    }

    function hasMemberDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    function userChurchId() {
      return hasMemberDoc()
        ? get(/databases/$(database)/documents/members/$(request.auth.uid)).data.get('churchId', '')
        : '';
    }

    function isSementeUser() {
      return isSignedIn() && userChurchId() == 'semente';
    }

    function docChurchId(data) {
      return data.get('churchId', null);
    }

    function docBelongsToChurch(data, targetChurchId) {
      return targetChurchId != '' && (
        docChurchId(data) == targetChurchId ||
        (targetChurchId == 'semente' && docChurchId(data) == null)
      );
    }

    function docBelongsToMyChurch(data) {
      return isMasterDeveloper() || (isSignedIn() && docBelongsToChurch(data, userChurchId()));
    }

    function isChurchAdminFor(churchId) {
      return isSignedIn() && (
        isMasterAdmin() ||
        (
          churchId != '' &&
          hasMemberDoc() &&
          get(/databases/$(database)/documents/members/$(request.auth.uid)).data.get('churchId', '') == churchId &&
          get(/databases/$(database)/documents/members/$(request.auth.uid)).data.get('isAdmin', false) == true
        )
      );
    }

    function isMyChurchAdmin() {
      return isMasterDeveloper() || (userChurchId() != '' && isChurchAdminFor(userChurchId()));
    }

    function isAdmin() {
      return isMyChurchAdmin();
    }

    function isValidSettings(data) {
      return (data.whatsappAdmin == null || data.whatsappAdmin is string)
        && (data.updatedAt == null || data.updatedAt is timestamp);
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---

    function isValidMember(data) {
      return (data.get('name', null) == null || (data.name is string && data.name.size() > 0 && data.name.size() <= 500))
        && (data.get('uid', null) == null || (data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128))
        && (data.get('roles', null) == null || data.roles is list)
        && (data.get('email', null) == null || (data.email is string && data.email.size() <= 200))
        && (data.get('isAdmin', null) == null || data.isAdmin is bool)
        && (data.get('availability', null) == null || data.availability is map)
        && (data.get('availabilityStatus', null) == null || data.availabilityStatus is map)
        && (data.get('whatsapp', null) == null || data.whatsapp is string)
        && (data.get('lastAvailabilityUpdate', null) == null || data.lastAvailabilityUpdate is timestamp)
        && (data.get('churchId', null) == null || (data.churchId is string && data.churchId.size() <= 128))
        && (data.get('favoriteSongs', null) == null || data.favoriteSongs is list)
        && (data.get('defaultBibleVersion', null) == null || data.defaultBibleVersion is string)
        && (data.get('fcmTokens', null) == null || (data.fcmTokens is list && data.fcmTokens.size() <= 50))
        && (data.get('fcmToken', null) == null || data.fcmToken is string)
        && (data.get('lastFcmToken', null) == null || data.lastFcmToken is string)
        && (data.get('lastFcmTokenUpdate', null) == null || data.lastFcmTokenUpdate is timestamp);
    }

    function isValidAdminEntry(data) {
      return (data.get('email', null) == null || (data.email is string && data.email.size() > 0 && data.email.size() <= 150))
        && (data.get('assignedAt', null) == null || data.assignedAt is timestamp);
    }

    function isValidChordOverride(data) {
      return data.get('frets', null) is list
        && (data.get('fingers', null) == null || data.fingers is list)
        && (data.get('baseFret', null) == null || data.baseFret is number)
        && (data.get('barre', null) == null || data.barre is map);
    }

    function isValidPianoChordOverride(data) {
      return data.get('keys', null) is list;
    }

    function isValidSong(data) {
      return (data.get('title', null) == null || (data.title is string && data.title.size() > 0 && data.title.size() <= 500))
        && (data.get('lyrics', null) == null || (data.lyrics is string && data.lyrics.size() <= 100000))
        && (data.get('artist', null) == null || (data.artist is string && data.artist.size() <= 500))
        && (data.get('chords', null) == null || (data.chords is string && data.chords.size() <= 100000))
        && (data.get('bpm', null) == null || data.bpm is number)
        && (data.get('tags', null) == null || data.tags is list)
        && (data.get('audio', null) == null || data.audio is list)
        && (data.get('baseKey', null) == null || data.baseKey is string)
        && (data.get('driveAudioLink', null) == null || data.driveAudioLink is string)
        && (data.get('driveFilesLink', null) == null || data.driveFilesLink is string)
        && (data.get('files', null) == null || data.files is list)
        && (data.get('churchId', null) == null || (data.churchId is string && data.churchId.size() <= 128))
        && (data.get('bibleReferences', null) == null || data.bibleReferences is map)
        && (data.get('themeSuggestions', null) == null || data.themeSuggestions is map)
        && (data.get('harmonyAnalysis', null) == null || data.harmonyAnalysis is map);
    }

    function isValidService(data) {
      return (data.get('title', null) == null || (data.get('title', '') is string && data.get('title', '').size() <= 1000))
        && (data.get('date', null) == null || (data.get('date', '') is string && data.get('date', '').size() > 0))
        && (data.get('scales', null) == null || data.get('scales', null) is map)
        && (data.get('setlist', null) == null || data.get('setlist', null) is list)
        && (data.get('liturgy', null) == null || data.get('liturgy', null) is list)
        && (data.get('availability', null) == null || data.get('availability', null) is map)
        && (data.get('playlistUrl', null) == null || (data.get('playlistUrl', '') is string && data.get('playlistUrl', '').size() <= 2000))
        && (data.get('createdAt', null) == null || data.get('createdAt', null) is timestamp)
        && (data.get('churchId', null) == null || (data.get('churchId', '') is string && data.get('churchId', '').size() <= 128));
    }

    function isValidAvailability(data) {
      return (data.get('userId', null) == null || data.userId == request.auth.uid || isMyChurchAdmin())
        && (data.get('date', null) == null || (data.date is string && data.date.size() >= 10 && data.date.size() <= 64))
        && (data.get('status', null) == null || data.status in ['available', 'unavailable'])
        && (data.get('churchId', null) == null || (data.churchId is string && data.churchId.size() <= 128))
        && (data.get('updatedAt', null) == null || data.updatedAt is timestamp);
    }

    function isValidAvailabilityLock(data) {
      return (data.unlocked is bool)
        && (data.get('unlockedAt', null) == null || data.unlockedAt is string)
        && (data.get('deadline', null) == null || data.deadline is string)
        && (data.get('churchId', null) == null || (data.churchId is string && data.churchId.size() <= 128));
    }

    function isValidAnnouncement(data) {
      return (data.get('text', null) == null || (data.text is string && data.text.size() > 0 && data.text.size() <= 2000))
        && (data.get('color', null) == null || (data.color is string && data.color.size() <= 100))
        && (data.get('createdAt', null) == null || data.createdAt is timestamp)
        && (data.get('churchId', null) == null || (data.churchId is string && data.churchId.size() <= 128));
    }

    function isValidMuralItem(data) {
      return (data.get('text', null) == null || (data.text is string && data.text.size() > 0 && data.text.size() <= 2000))
        && (data.get('type', null) == null || data.type in ['sugestao', 'ideia', 'necessidade', 'oracao', 'outro'])
        && (data.get('authorId', null) == null || (data.authorId is string && data.authorId == request.auth.uid))
        && (data.get('authorName', null) == null || (data.authorName is string && data.authorName.size() <= 200))
        && (data.get('createdAt', null) == null || data.createdAt is timestamp)
        && (data.get('churchId', null) == null || (data.churchId is string && data.churchId.size() <= 128));
    }

    function isValidNotification(data) {
      return (data.get('userId', null) == null || data.userId is string)
        && (data.get('title', null) == null || data.title is string)
        && (data.get('content', null) == null || data.content is string)
        && (data.get('type', null) == null || data.type in ['announcement', 'mural', 'service', 'general'])
        && (data.get('read', null) == null || data.read is bool)
        && (data.get('deleted', null) == null || data.deleted is bool)
        && (data.get('churchId', null) == null || (data.churchId is string && data.churchId.size() <= 128))
        && (data.get('createdAt', null) == null || data.createdAt is timestamp);
    }

    function isValidChatMessage(data) {
      return (data.get('text', null) == null || (data.text is string && data.text.size() > 0 && data.text.size() <= 2000))
        && (data.get('authorId', null) == null || (data.authorId is string && data.authorId == request.auth.uid))
        && (data.get('authorName', null) == null || (data.authorName is string && data.authorName.size() <= 200))
        && (data.get('authorRole', null) == null || (data.authorRole is string && data.authorRole.size() <= 100))
        && (data.get('createdAt', null) == null || data.createdAt is timestamp)
        && (data.get('churchId', null) == null || (data.churchId is string && data.churchId.size() <= 128));
    }

    function isValidProjectionPreset(data) {
      return (data.get('name', '') is string && data.get('name', '').size() > 0 && data.get('name', '').size() <= 200)
        && (data.get('url', '') is string && data.get('url', '').size() > 0 && data.get('url', '').size() <= 2500000)
        && (data.get('desc', null) == null || (data.desc is string && data.desc.size() <= 1000))
        && (data.get('icon', null) == null || (data.icon is string && data.icon.size() <= 50))
        && (data.get('churchId', null) == null || (data.churchId is string && data.churchId.size() <= 128))
        && (data.get('createdAt', null) == null || data.createdAt is timestamp);
    }

    function isValidProjectionSession(data) {
      return (data.get('churchId', null) == null || (data.churchId is string && data.churchId.size() <= 128))
        && (data.get('text', null) == null || (data.text is string && data.text.size() <= 20000))
        && (data.get('theme', null) == null || data.theme is string)
        && (data.get('fontSize', null) == null || data.fontSize is number)
        && (data.get('activeSlideIdx', null) == null || data.activeSlideIdx is number)
        && (data.get('activeSongTitle', null) == null || data.activeSongTitle is string)
        && (data.get('activeSongArtist', null) == null || data.activeSongArtist is string)
        && (data.get('activeSongId', null) == null || data.activeSongId is string)
        && (data.get('slides', null) == null || data.slides is list)
        && (data.get('blackout', null) == null || data.blackout is bool)
        && (data.get('clearText', null) == null || data.clearText is bool)
        && (data.get('showLogo', null) == null || data.showLogo is bool)
        && (data.get('scrollingAlert', null) == null || (data.scrollingAlert is string && data.scrollingAlert.size() <= 1000))
        && (data.get('projectorOnlineAt', null) == null || data.projectorOnlineAt is timestamp || data.projectorOnlineAt is string)
        && (data.get('operatorOnlineAt', null) == null || data.operatorOnlineAt is timestamp || data.operatorOnlineAt is string)
        && (data.get('pingTimestamp', null) == null || data.pingTimestamp is number)
        && (data.get('updatedAt', null) == null || data.updatedAt is timestamp || data.updatedAt is string);
    }

    function isValidPresence(data) {
      return data.name is string && data.name.size() <= 200
        && (data.get('churchId', null) == null || (data.churchId is string && data.churchId.size() <= 128))
        && (data.get('lastActive', null) == null || data.lastActive is timestamp);
    }

    function isValidChurch(data) {
      return (data.get('name', null) == null || (data.name is string && data.name.size() > 0 && data.name.size() <= 500))
        && (data.get('inviteCode', null) == null || (data.inviteCode is string && data.inviteCode.size() > 0 && data.inviteCode.size() <= 100))
        && (data.get('leaderWhatsapp', null) == null || (data.leaderWhatsapp is string && data.leaderWhatsapp.size() <= 40))
        && (data.get('createdBy', null) == null || (data.createdBy is string))
        && (data.get('createdAt', null) == null || data.createdAt is timestamp || data.createdAt is string);
    }

    // --- Collection Rules ---
    match /chord_overrides/{chordName} {
      allow get, list: if isSignedIn();
      allow create: if isMyChurchAdmin() && incoming().keys().hasAll(['frets']) && isValidChordOverride(incoming());
      allow update: if isMyChurchAdmin() && isValidChordOverride(incoming());
      allow delete: if isMyChurchAdmin();
    }

    match /piano_chord_overrides/{chordName} {
      allow get, list: if isSignedIn();
      allow create: if isMyChurchAdmin() && incoming().keys().hasAll(['keys']) && isValidPianoChordOverride(incoming());
      allow update: if isMyChurchAdmin() && isValidPianoChordOverride(incoming());
      allow delete: if isMyChurchAdmin();
    }

    match /settings/{docId} {
      allow get: if isMasterDeveloper()
                 || (isSignedIn() && userChurchId() != '' && (
                      (docId == 'notifications' && isSementeUser()) ||
                      docId == ('notifications_' + userChurchId())
                    ));
      allow list: if isMasterDeveloper();
      allow create, update: if isValidSettings(incoming()) && (
                              isMasterDeveloper() ||
                              (
                                isMyChurchAdmin() &&
                                (
                                  (docId == 'notifications' && isSementeUser()) ||
                                  docId == ('notifications_' + userChurchId())
                                ) &&
                                incoming().get('churchId', userChurchId()) == userChurchId()
                              )
                            );
      allow delete: if isMasterDeveloper();
    }

    match /projection_presets/{presetId} {
      allow get: if isMasterDeveloper() || (isSignedIn() && userChurchId() != '' && docBelongsToMyChurch(existing()));
      allow list: if isMasterDeveloper() || isSementeUser() || (isSignedIn() && userChurchId() != '' && resource.data.churchId == userChurchId());
      allow create: if isSignedIn() && userChurchId() != '' && incoming().keys().hasAll(['name', 'url']) && isValidProjectionPreset(incoming())
                    && (isMasterDeveloper() || incoming().get('churchId', '') == userChurchId());
      allow update: if isSignedIn() && userChurchId() != '' && docBelongsToMyChurch(existing()) && isValidProjectionPreset(incoming())
                    && (isMasterDeveloper() || incoming().get('churchId', existing().get('churchId', '')) == existing().get('churchId', ''));
      allow delete: if isMasterDeveloper() || (isSignedIn() && userChurchId() != '' && docBelongsToMyChurch(existing()));
    }

    match /projection_sessions/{sessionId} {
      allow get: if isValidId(sessionId);
      allow list: if isMasterDeveloper();
      allow create, update: if isValidId(sessionId) && isValidProjectionSession(incoming()) && (
                              isMasterDeveloper() ||
                              (isSignedIn() && userChurchId() != '' && (sessionId == userChurchId() || incoming().get('churchId', '') == userChurchId()))
                            );
      allow delete: if isMasterDeveloper() || (isMyChurchAdmin() && sessionId == userChurchId());
    }

    // Admin List Rules (Strict Tenant Isolation)
    match /admins/{userId} {
      allow get: if isMasterDeveloper() || (isSignedIn() && (userId == request.auth.uid || (userChurchId() != '' && docBelongsToMyChurch(existing()))));
      allow list: if isMasterDeveloper() || isSementeUser() || (isMyChurchAdmin() && resource.data.churchId == userChurchId());
      allow create: if isMasterAdmin() && incoming().keys().hasAll(['email']) && isValidAdminEntry(incoming());
      allow update: if isMasterAdmin() && isValidAdminEntry(incoming());
      allow delete: if isMasterAdmin();
    }

    // Announcement Rules (Strict Tenant Isolation)
    match /announcements/{annId} {
      allow get: if isMasterDeveloper() || (isSignedIn() && userChurchId() != '' && docBelongsToMyChurch(existing()));
      allow list: if isMasterDeveloper() || isSementeUser() || (isSignedIn() && userChurchId() != '' && resource.data.churchId == userChurchId());
      allow create: if isSignedIn() && incoming().keys().hasAll(['text']) && isValidAnnouncement(incoming())
                    && (isMasterDeveloper() || (isMyChurchAdmin() && incoming().get('churchId', '') == userChurchId()));
      allow update: if isSignedIn() && isValidAnnouncement(incoming())
                    && (isMasterDeveloper() || (isMyChurchAdmin() && docBelongsToMyChurch(existing()) && incoming().get('churchId', existing().get('churchId', '')) == existing().get('churchId', '')));
      allow delete: if isMasterDeveloper() || (isMyChurchAdmin() && docBelongsToMyChurch(existing()));
    }

    // Availability Rules (Strict Tenant Isolation)
    match /availability/{availabilityId} {
      allow get: if isMasterDeveloper() || (isSignedIn() && (existing().userId == request.auth.uid || (userChurchId() != '' && docBelongsToMyChurch(existing()))));
      allow list: if isMasterDeveloper() || isSementeUser() || (isSignedIn() && resource.data.userId == request.auth.uid) || (isSignedIn() && userChurchId() != '' && resource.data.churchId == userChurchId());
      allow create: if isSignedIn() && userChurchId() != '' && incoming().keys().hasAll(['userId', 'date', 'status']) && isValidAvailability(incoming())
                    && (isMasterDeveloper() || (incoming().get('churchId', '') == userChurchId() && (incoming().userId == request.auth.uid || isMyChurchAdmin())));
      allow update: if isSignedIn() && userChurchId() != '' && isValidAvailability(incoming())
                    && (isMasterDeveloper() || (docBelongsToMyChurch(existing()) && (existing().userId == request.auth.uid || isMyChurchAdmin()) && incoming().get('churchId', existing().get('churchId', '')) == existing().get('churchId', '')));
      allow delete: if isMasterDeveloper() || (isSignedIn() && userChurchId() != '' && docBelongsToMyChurch(existing()) && (existing().userId == request.auth.uid || isMyChurchAdmin()));
    }

    // Availability Lock Rules (Strict Tenant Isolation)
    match /availability_locks/{lockId} {
      allow get: if isMasterDeveloper() || (isSignedIn() && userChurchId() != '' && docBelongsToMyChurch(existing()));
      allow list: if isMasterDeveloper() || isSementeUser() || (isSignedIn() && userChurchId() != '' && resource.data.churchId == userChurchId());
      allow create: if isSignedIn() && incoming().keys().hasAll(['unlocked']) && isValidAvailabilityLock(incoming())
                    && (isMasterDeveloper() || (isMyChurchAdmin() && incoming().get('churchId', '') == userChurchId() && lockId.matches('^' + userChurchId() + '_.*')));
      allow update: if isSignedIn() && isValidAvailabilityLock(incoming())
                    && (isMasterDeveloper() || (isMyChurchAdmin() && docBelongsToMyChurch(existing()) && incoming().get('churchId', existing().get('churchId', '')) == existing().get('churchId', '')));
      allow delete: if isMasterDeveloper() || (isMyChurchAdmin() && docBelongsToMyChurch(existing()));
    }

    // Member Rules (Strict Tenant Isolation)
    match /members/{memberId} {
      allow get: if isMasterDeveloper() || (isSignedIn() && (
                   memberId == request.auth.uid ||
                   existing().get('uid', '') == request.auth.uid ||
                   (userChurchId() != '' && docBelongsToMyChurch(existing()))
                 ));
      allow list: if isMasterDeveloper() || isSementeUser() || (isSignedIn() && userChurchId() != '' && resource.data.churchId == userChurchId());
      allow create: if isSignedIn() && isValidMember(incoming()) && (
                      isMasterDeveloper() ||
                      (memberId == request.auth.uid && incoming().get('uid', '') == request.auth.uid && incoming().get('isAdmin', false) == false) ||
                      (isMyChurchAdmin() && incoming().get('churchId', '') == userChurchId() && incoming().get('isAdmin', false) == false)
                    );
      allow update: if isSignedIn() && isValidMember(incoming()) && (
                      isMasterDeveloper() ||
                      (
                        (
                          request.auth.uid == memberId ||
                          existing().get('uid', '') == request.auth.uid ||
                          (
                            isEmailVerified() &&
                            existing().get('email', '') != '' &&
                            existing().get('email', '') == request.auth.token.email &&
                            existing().get('churchId', '') == userChurchId()
                          )
                        ) &&
                        (
                          existing().get('churchId', '') == '' ||
                          incoming().get('churchId', existing().get('churchId', '')) == existing().get('churchId', '')
                        ) &&
                        (incoming().get('isAdmin', existing().get('isAdmin', false)) == existing().get('isAdmin', false) || incoming().get('isAdmin', false) == false)
                      ) ||
                      (
                        isMyChurchAdmin() &&
                        docBelongsToMyChurch(existing()) &&
                        incoming().get('isAdmin', existing().get('isAdmin', false)) == existing().get('isAdmin', false) &&
                        incoming().get('churchId', existing().get('churchId', '')) == existing().get('churchId', '')
                      )
                    );
      allow delete: if isMasterDeveloper() || (isMyChurchAdmin() && docBelongsToMyChurch(existing()));
    }

    // FCM Device Tokens Rules (Strict Tenant Isolation)
    match /fcm_tokens/{tokenId} {
      allow get: if isMasterDeveloper() || (isSignedIn() && (existing().uid == request.auth.uid || (userChurchId() != '' && docBelongsToMyChurch(existing()))));
      allow list: if isMasterDeveloper() || isSementeUser() || (isSignedIn() && resource.data.uid == request.auth.uid) || (isSignedIn() && userChurchId() != '' && resource.data.churchId == userChurchId());
      allow create, update: if isSignedIn() && (isMasterDeveloper() || incoming().uid == request.auth.uid || (isMyChurchAdmin() && incoming().get('churchId', '') == userChurchId()));
      allow delete: if isMasterDeveloper() || (isSignedIn() && (existing().uid == request.auth.uid || (isMyChurchAdmin() && docBelongsToMyChurch(existing()))));
    }

    // Song Rules (Strict Multi-Tenant Isolation - Semente Completely Confidential)
    match /songs/{songId} {
      allow get: if isMasterDeveloper() || (isSignedIn() && userChurchId() != '' && docBelongsToMyChurch(existing()));
      allow list: if isMasterDeveloper() || isSementeUser() || (isSignedIn() && userChurchId() != '' && resource.data.churchId == userChurchId());
      allow create: if isSignedIn() && userChurchId() != '' && incoming().keys().hasAll(['title']) && isValidSong(incoming())
                    && (isMasterDeveloper() || incoming().get('churchId', '') == userChurchId());
      allow update: if isSignedIn() && userChurchId() != '' && docBelongsToMyChurch(existing()) && isValidSong(incoming())
                    && (isMasterDeveloper() || incoming().get('churchId', existing().get('churchId', '')) == existing().get('churchId', ''));
      allow delete: if isMasterDeveloper() || (isMyChurchAdmin() && docBelongsToMyChurch(existing()));
    }

    match /churches/{churchId}/songs/{songId} {
      allow get, list: if isMasterDeveloper() || (isSignedIn() && userChurchId() == churchId);
      allow create, update: if isMasterDeveloper() || (isSignedIn() && userChurchId() == churchId);
      allow delete: if isMasterDeveloper() || isChurchAdminFor(churchId);
    }

    // Service Rules (Strict Multi-Tenant Isolation - Semente Completely Confidential)
    match /services/{serviceId} {
      allow get: if isMasterDeveloper() || (isSignedIn() && userChurchId() != '' && docBelongsToMyChurch(existing()));
      allow list: if isMasterDeveloper() || isSementeUser() || (isSignedIn() && userChurchId() != '' && resource.data.churchId == userChurchId());
      allow create: if isSignedIn() && incoming().keys().hasAll(['title', 'date']) && isValidService(incoming())
                    && (isMasterDeveloper() || (isMyChurchAdmin() && incoming().get('churchId', '') == userChurchId()));
      allow update: if isSignedIn() && userChurchId() != '' && docBelongsToMyChurch(existing()) && isValidService(incoming())
                    && (
                      isMasterDeveloper() ||
                      (
                        (isMyChurchAdmin() || incoming().diff(existing()).affectedKeys().hasOnly(['availability'])) &&
                        incoming().get('churchId', existing().get('churchId', '')) == existing().get('churchId', '')
                      )
                    );
      allow delete: if isMasterDeveloper() || (isMyChurchAdmin() && docBelongsToMyChurch(existing()));
    }

    // Mural Rules (Strict Tenant Isolation)
    match /mural/{itemId} {
      allow get: if isMasterDeveloper() || (isSignedIn() && userChurchId() != '' && docBelongsToMyChurch(existing()));
      allow list: if isMasterDeveloper() || isSementeUser() || (isSignedIn() && userChurchId() != '' && resource.data.churchId == userChurchId());
      allow create: if isSignedIn() && userChurchId() != '' && incoming().keys().hasAll(['text', 'type', 'authorId', 'authorName', 'createdAt']) && isValidMuralItem(incoming())
                    && (isMasterDeveloper() || incoming().get('churchId', '') == userChurchId());
      allow update: if isSignedIn() && userChurchId() != '' && docBelongsToMyChurch(existing()) && isValidMuralItem(incoming())
                    && (isMasterDeveloper() || ((isMyChurchAdmin() || existing().authorId == request.auth.uid) && incoming().get('churchId', existing().get('churchId', '')) == existing().get('churchId', '')));
      allow delete: if isMasterDeveloper() || (isSignedIn() && userChurchId() != '' && docBelongsToMyChurch(existing()) && (isMyChurchAdmin() || existing().authorId == request.auth.uid));
    }

    // Notification Rules (Strict User + Tenant Isolation)
    match /notifications/{notifId} {
      allow list: if isMasterDeveloper() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow get: if isMasterDeveloper() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && (isMasterDeveloper() || (userChurchId() != '' && incoming().get('churchId', userChurchId()) == userChurchId()));
      allow update: if isSignedIn() && (isMasterDeveloper() || resource.data.userId == request.auth.uid) && incoming().diff(existing()).affectedKeys().hasOnly(['read', 'deleted']);
      allow delete: if isSignedIn() && (isMasterDeveloper() || resource.data.userId == request.auth.uid);
    }

    // Chat Rules (Strict Tenant Isolation)
    match /chat/{messageId} {
      allow get: if isMasterDeveloper() || (isSignedIn() && userChurchId() != '' && docBelongsToMyChurch(existing()));
      allow list: if isMasterDeveloper() || isSementeUser() || (isSignedIn() && userChurchId() != '' && resource.data.churchId == userChurchId());
      allow create: if isSignedIn() && userChurchId() != '' && incoming().keys().hasAll(['text', 'authorId', 'authorName', 'createdAt']) && isValidChatMessage(incoming())
                    && (isMasterDeveloper() || incoming().get('churchId', '') == userChurchId());
      allow update: if isSignedIn() && userChurchId() != '' && docBelongsToMyChurch(existing()) && isValidChatMessage(incoming())
                    && (isMasterDeveloper() || ((isMyChurchAdmin() || existing().authorId == request.auth.uid) && incoming().get('churchId', existing().get('churchId', '')) == existing().get('churchId', '')));
      allow delete: if isMasterDeveloper() || (isSignedIn() && userChurchId() != '' && docBelongsToMyChurch(existing()) && (isMyChurchAdmin() || existing().authorId == request.auth.uid));
    }

    // Presence Rules (Strict Tenant Isolation)
    match /presence/{userId} {
      allow get: if isMasterDeveloper() || (isSignedIn() && (userId == request.auth.uid || (userChurchId() != '' && docBelongsToMyChurch(existing()))));
      allow list: if isMasterDeveloper() || isSementeUser() || (isSignedIn() && userChurchId() != '' && resource.data.churchId == userChurchId());
      allow create, update: if isSignedIn() && request.auth.uid == userId && isValidPresence(incoming())
                            && (isMasterDeveloper() || (userChurchId() != '' && incoming().get('churchId', '') == userChurchId()));
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Church Rules
    match /churches/{churchId} {
      allow get: if isValidId(churchId);
      allow list: if true;
      allow create: if isValidId(churchId)
                    && isValidChurch(incoming())
                    && isMasterDeveloper();
      allow update: if isSignedIn()
                    && isValidId(churchId)
                    && isValidChurch(incoming())
                    && (
                      isMasterDeveloper() ||
                      (
                        churchId == 'semente'
                        && isChurchAdminFor('semente')
                        && incoming().diff(existing()).affectedKeys().hasOnly(['teamDriveUrl', 'leaderWhatsapp', 'updatedAt'])
                        && incoming().get('name', existing().get('name', 'Graça Soberana')) == existing().get('name', 'Graça Soberana')
                      ) ||
                      (
                        churchId != 'semente'
                        && isChurchAdminFor(churchId)
                        && incoming().get('isSeedChurch', false) == false
                        && incoming().get('isVitalicio', false) == existing().get('isVitalicio', false)
                        && incoming().get('planStatus', '') == existing().get('planStatus', '')
                        && incoming().get('planName', '') == existing().get('planName', '')
                        && incoming().get('planExpiresAt', null) == existing().get('planExpiresAt', null)
                      )
                    );
      allow delete: if isValidId(churchId) && isMasterDeveloper();
    }

    // Kiwify Webhook Log Rules
    match /kiwify_webhooks/{logId} {
      allow read, write: if true;
    }

    // Password Token Rules
    match /password_tokens/{tokenId} {
      allow read, write: if true;
    }

    // Default deny - placed at the end to ensure more specific matches have priority
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
